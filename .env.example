# Database Configuration
DATABASE_URL=sqlite:///esr_foods.db

# Security
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
ESR_ADMIN_USERNAME=admin
ESR_ADMIN_EMAIL=admin@esrfoods.com
# Optional. If omitted, seed_data.py generates and prints a one-time strong password.
ESR_ADMIN_PASSWORD=
# Application Settings
APP_NAME=ESR Foods Business Operations Management System
APP_VERSION=1.0.0
DEBUG=True

# CORS Settings
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
