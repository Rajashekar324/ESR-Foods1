# Local database configuration. On Render, mount a persistent disk at /var/data
# and set DATABASE_URL=sqlite:////var/data/esr_foods.db.
DATABASE_URL=sqlite:///esr_foods.db

# Security
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
# Bootstrap Admin credentials (keep the password private; never commit .env).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@esrfoods.com
ADMIN_PASSWORD=
# Legacy ESR_ADMIN_* names remain supported for existing local .env files.
# ESR_ADMIN_USERNAME=admin
# ESR_ADMIN_EMAIL=admin@esrfoods.com
# ESR_ADMIN_PASSWORD=
# Application Settings
APP_NAME=ESR Foods Business Operations Management System
APP_VERSION=1.0.0
DEBUG=True

# CORS Settings
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
